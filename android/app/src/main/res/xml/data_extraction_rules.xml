<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup rules — the modern replacement for
  backup_rules.xml, kept with the same logic for both cloud backup and
  device-to-device transfer: only the database is included, so the
  secure-storage API key is left out automatically (see backup_rules.xml
  for why).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
